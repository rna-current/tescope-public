# PyInstaller spec for the TEscope desktop application (GUI + embedded CLI).
# Build:  pyinstaller packaging/tescope-gui.spec
# Produces a one-directory bundle (dist/TEscope) suitable for wrapping in an
# OS installer (Inno Setup on Windows, .app/.dmg on macOS).

import sys
from PyInstaller.utils.hooks import collect_submodules

block_cipher = None

hidden = (
    collect_submodules("tescope")
    + ["pybigtools", "matplotlib.backends.backend_qtagg", "matplotlib.backends.backend_agg"]
)
try:
    import pyBigWig  # noqa: F401
    hidden.append("pyBigWig")
except ImportError:
    pass

a = Analysis(
    ["tescope_gui_launcher.py"],
    pathex=[],
    binaries=[],
    # approved TEscope branding (window icon + About logo); resolved by
    # tescope.gui.theme.icons._branding_dir() via sys._MEIPASS when frozen
    datas=[("../src/tescope/gui/theme/branding",
            "tescope/gui/theme/branding"),
           # offline About/Help resources (license, citation, help)
           ("../src/tescope/resources", "tescope/resources")],
    hiddenimports=hidden,
    hookspath=[],
    runtime_hooks=[],
    excludes=[
        "tkinter", "PyQt5", "PyQt6", "IPython", "jupyter",
        # Qt modules TEscope does not use (pure QtWidgets app)
        "PySide6.QtQuick", "PySide6.QtQml", "PySide6.QtQuickWidgets",
        "PySide6.QtPdf", "PySide6.QtPdfWidgets", "PySide6.QtWebEngineCore",
        "PySide6.Qt3DCore", "PySide6.QtMultimedia",
    ],
    cipher=block_cipher,
)
pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="TEscope",
    debug=False,
    strip=False,
    upx=False,
    console=False,  # windowed app; the CLI ships separately via pip/uv
    # approved TEscope symbol icon (generated by
    # assets/branding/generate_assets.py); Windows embeds it in the EXE
    icon="tescope.ico" if sys.platform.startswith("win") else None,
)
coll = COLLECT(
    exe,
    a.binaries,
    a.zipfiles,
    a.datas,
    strip=False,
    upx=False,
    name="TEscope",
)

if sys.platform == "darwin":
    app = BUNDLE(
        coll,
        name="TEscope.app",
        icon="tescope.icns",  # approved TEscope symbol (generated asset)
        bundle_identifier="org.rnacurrent.tescope",
        info_plist={
            "NSHighResolutionCapable": True,
            "NSHumanReadableCopyright": "MIT License",
        },
    )
